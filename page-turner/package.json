{
  "name": "page-turner",
  "version": "1.0.0",
  "private": true,
  "description": "피아노 소리와 박자를 함께 따라가며 악보를 자동으로 넘기는 앱 (웹·안드로이드·iOS)",
  "scripts": {
    "start": "node tests/serve.js",
    "test": "node tests/run-tests.js",
    "test:e2e": "node tests/e2e-demo.js && node tests/e2e-pwa.js",
    "make-sample": "node tools/make-sample.js",
    "build:web": "node tools/build-web.js",
    "cap:sync": "npm run build:web && npx cap sync",
    "android:apk": "npm run cap:sync && cd android && ./gradlew assembleDebug"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@xmldom/xmldom": "^0.8.15"
  },
  "optionalDependencies": {
    "playwright": "^1.56.1"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2"
  }
}
